{
  "model": "opus",
  "permissions": {
    "deny": [
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(kubectl:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(orca orchestration reset:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin production:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bin/guard-commands.sh"
          }
        ]
      }
    ]
  }
}
